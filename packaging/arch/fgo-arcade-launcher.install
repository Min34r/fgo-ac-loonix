post_install() {
    echo ":: Fate/Grand Order Arcade Launcher installed to /opt/fgoa-launcher."
    echo ":: Attach the launcher overlay to your extracted FGO Arcade game folder:"
    echo "::   /opt/fgoa-launcher/install.sh /path/to/FGOA"
    echo ":: Afterwards, launch from your app menu or run: fgo-launcher"
    echo ":: Ensure 192.168.100.1 is configured on your loopback device:"
    echo "::   sudo ip addr add 192.168.100.1/24 dev lo"
}

post_upgrade() {
    post_install
}
